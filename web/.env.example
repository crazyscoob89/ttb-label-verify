# Live demo (Node 24 only). Disabled unless every required value is set.
TTB_DEMO_ENABLED=false
TTB_DEMO_ORIGIN=https://demo.example.invalid
# Inject privately at runtime: 32 random bytes encoded as base64url (43 chars).
TTB_DEMO_ACCESS_SECRET=
OPENROUTER_API_KEY=
# Absolute real path on ONE private persistent local volume, mode 0700.
# Never use public/, a repository path, ephemeral container storage or /tmp.
TTB_DEMO_DATA_DIR=
TTB_DEMO_PERSISTENT_VOLUME=single-private-volume-v1
NEXT_TELEMETRY_DISABLED=1
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
PLAYWRIGHT_OUTPUT_DIR=
