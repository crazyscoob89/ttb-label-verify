# Node 24.x. Disabled by default; no credential belongs in NEXT_PUBLIC_*.
TTB_DEMO_ENABLED=false
TTB_DEMO_ORIGIN=https://demo.example.invalid
# Independently generate each: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# The access code is user-entered; the media signer MUST stay server-only.
TTB_DEMO_ACCESS_SECRET=
TTB_MEDIA_SIGNING_SECRET=
OPENROUTER_API_KEY=

# Vercel + dedicated Supabase (root directory web). Exact same origin in both.
TTB_PERSISTENCE=supabase
TTB_SUPABASE_URL=https://your-project-ref.supabase.co
TTB_SUPABASE_SERVICE_ROLE_KEY=
TTB_SUPABASE_EVIDENCE_BUCKET=ttb-evidence
TTB_SUPABASE_UPLOAD_BUCKET=ttb-uploads
# Public values are fixed at build time: rebuild after changing either.
NEXT_PUBLIC_TTB_MEDIA_TRANSPORT=supabase-v1
NEXT_PUBLIC_TTB_SUPABASE_ORIGIN=https://your-project-ref.supabase.co

# Local SQLite alternative ONLY: set TTB_PERSISTENCE=sqlite; unset all Supabase
# and NEXT_PUBLIC_TTB_* settings above. Uncomment private provisioned paths.
# Never set these in Vercel or create a fresh ledger to reset the budget.
# TTB_DEMO_DATA_DIR=/absolute/private/persistent/spend
# TTB_DEMO_PERSISTENT_VOLUME=single-private-volume-v1
# TTB_REVIEW_DATA_DIR=/absolute/private/persistent/reviews
NEXT_TELEMETRY_DISABLED=1
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
PLAYWRIGHT_OUTPUT_DIR=
